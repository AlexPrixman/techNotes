PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/technotes
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development generates a temporary session secret when unset. Set a persistent one for deployment.
SESSION_SECRET=
NODE_ENV=development
# Set TRUST_PROXY=1 only behind one trusted reverse proxy.
TRUST_PROXY=0
COOKIE_SAME_SITE=lax
